---
import { siteConfig } from "../config";
---

<section id="about" class="px-8 py-16 sm:px-12 sm:py-20 md:px-24 md:py-24">
  <p class="text-xs font-medium tracking-widest uppercase mb-6" style={`color: ${siteConfig.accentColor}`}>About</p>

  <div class="flex flex-col md:flex-row gap-16">

    <!-- Left: Tagline + Bio -->
    <div class="flex-1">
      <h2 class="text-4xl md:text-5xl font-bold text-gray-900 leading-tight mb-2">Quality by instinct.</h2>
      <h2 class="text-4xl md:text-5xl font-bold text-gray-900 leading-tight mb-2">Engineer at the core.</h2>
      <h2 class="text-4xl md:text-5xl font-bold text-gray-900 leading-tight mb-10">Builder of teams that ship.</h2>

      {siteConfig.aboutMe.split("\n\n").map((para) => (
  <p class="text-gray-600 mb-5" style="font-size: 0.95rem; line-height: 1.8;">
    {para}
  </p>
))}
    </div>

    <!-- Right: Core Expertise -->
<div class="md:w-[480px] flex-shrink-0">
  <p class="text-xs font-medium tracking-widest uppercase mb-6 text-gray-400">Core Expertise</p>
  <div class="space-y-4">
    {siteConfig.skills.map((group) => (
      <div class="py-3 px-4 border border-gray-100 bg-white hover:border-gray-300 transition-colors duration-200">
        <div class="flex items-center gap-2 mb-2">
          <span class="w-1.5 h-1.5 rounded-full flex-shrink-0" style={`background-color: ${siteConfig.accentColor}`}></span>
          <span class="text-xs font-semibold tracking-widest uppercase text-gray-500">{group.category}</span>
        </div>
        <p class="text-sm text-gray-700 pl-3">{group.items.join(" · ")}</p>
      </div>
    ))}
  </div>
</div>

  </div>
</section>
