---
import { siteConfig } from "../config";
---

<section id="certifications" class="px-8 py-16 sm:px-12 sm:py-20 md:px-24 md:py-24">
<p class="text-xs font-medium tracking-widest uppercase mb-6" style={`color: ${siteConfig.accentColor}`}>Credentials</p>
<h2 class="text-4xl md:text-5xl font-bold text-gray-900 leading-tight mb-10">Certified, from test to AI.</h2>

  <!-- Certifications grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-10">
    {siteConfig.certifications.map((cert) => (
      <div class="bg-white rounded-xl border border-gray-100 p-5 flex items-center gap-4 hover:shadow-md transition-shadow duration-300">
        <div class="flex-shrink-0 w-10 h-10 rounded-full flex items-center justify-center" style={`background-color: ${siteConfig.accentColor}`}>
          <span class="text-white text-lg">✦</span>
        </div>
        <div class="flex-1 min-w-0">
          <h3 class="text-base font-semibold text-gray-900 leading-tight">{cert.degree}</h3>
          <p class="text-sm text-gray-500 mt-0.5">{cert.school} · {cert.dateRange}</p>
        </div>
      </div>
    ))}
  </div>

  <!-- Education footnote -->
  {siteConfig.education.map((edu) => (
    <p class="text-sm italic text-gray-400">
      {edu.degree} — {edu.school} ({edu.dateRange})
    </p>
  ))}
</section>
