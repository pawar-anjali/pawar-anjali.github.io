---
import { siteConfig } from "../config";
---
<section id="contact" class="px-8 py-16 sm:px-12 sm:py-20 md:px-24 md:py-24">
  <p class="text-xs font-medium tracking-widest uppercase mb-6" style={`color: ${siteConfig.accentColor}`}>Contact</p>

  <div class="flex flex-col md:flex-row gap-16">
    <!-- Left: Text -->
    <div class="flex-1">
      <h2 class="text-5xl md:text-6xl font-bold text-gray-900 leading-tight mb-2">Let's</h2>
      <h2 class="text-5xl md:text-6xl font-bold italic mb-10" style={`color: ${siteConfig.accentColor}`}>connect</h2>
      <p class="text-gray-500 text-base leading-relaxed mb-3 max-w-md">
        Whether you're looking for a QA leader, automation engineer, or AI quality specialist — I'd love to hear from you.
      </p>
      <p class="text-gray-500 text-base leading-relaxed max-w-md">
        Currently based in Pune, India. Open to global remote and Japan-based roles.
      </p>
    </div>

    <!-- Right: Contact boxes -->
    <div class="flex flex-col gap-4 flex-1">
      <a href={`mailto:${siteConfig.social.email}`} class="contact-card">
        <span class="contact-icon" style={`color: ${siteConfig.accentColor}`}>✉</span>
        <div>
          <p class="text-gray-900 font-medium">{siteConfig.social.email}</p>
          <p class="text-gray-400 text-sm">Email</p>
        </div>
      </a>
      <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer" class="contact-card">
        <span class="contact-icon font-bold" style={`color: ${siteConfig.accentColor}`}>in</span>
        <div>
          <p class="text-gray-900 font-medium">linkedin.com/in/pawaranjali</p>
          <p class="text-gray-400 text-sm">LinkedIn</p>
        </div>
      </a>
      <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer" class="contact-card">
        <span class="contact-icon" style={`color: ${siteConfig.accentColor}`}>
  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2c2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2a4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0c-2.4-1.6-3.5-1.3-3.5-1.3a4.2 4.2 0 0 0-.1 3.2a4.6 4.6 0 0 0-1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6.6-.6 1.2-.5 2v3.5"/>
  </svg>
</span>
        <div>
          <p class="text-gray-900 font-medium">github.com/pawar-anjali</p>
          <p class="text-gray-400 text-sm">GitHub</p>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  .contact-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    background-color: white;
    border: 1px solid #e5e0d8;
    text-decoration: none;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .contact-card:hover {
    border-color: var(--gold);
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
  }
  .contact-icon {
    font-size: 1.1rem;
    width: 2rem;
    text-align: center;
    flex-shrink: 0;
  }
</style>
