---
import { siteConfig } from "../config";
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
---
{hasExperience && (
  <section id="experience" class="px-8 py-16 sm:px-12 sm:py-20 md:px-24 md:py-24">
    <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900 mb-2">Experience</h2>
    <div class="w-16 h-1 rounded-full mb-10" style={`background-color: ${siteConfig.accentColor}`}></div>
    <div class="relative">
      {siteConfig.experience.map((exp, index) => (
        <div class="relative mb-12 last:mb-0">
          <div
            class="absolute left-1/2 -top-2 w-4 h-4 rounded-full -translate-x-1/2 z-20"
            style={`border: 2px solid ${siteConfig.accentColor}; background-color: ${siteConfig.accentColor}`}
          />
          {index < siteConfig.experience.length - 1 && (
            <div class="absolute left-1/2 bottom-0 w-0.5 h-12 bg-gray-300 -translate-x-1/2 translate-y-full z-10" />
          )}
          <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-5 md:p-8 hover:shadow-md transition-shadow duration-300">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-4">
              <div>
                <h3 class="text-lg sm:text-xl font-semibold text-gray-900">{exp.title}</h3>
                <p class="text-base sm:text-lg" style={`color: ${siteConfig.accentColor}`}>{exp.company}</p>
              </div>
              <span class="text-xs sm:text-sm text-gray-500 mt-2 sm:mt-0">{exp.dateRange}</span>
            </div>

            <!-- Paragraph description -->
            <p class="text-gray-600 leading-relaxed mb-6" style="font-size: 0.95rem; line-height: 1.8;">
              {exp.description}
            </p>

            <!-- Skill tags -->
            {exp.skills && exp.skills.length > 0 && (
              <div class="flex flex-wrap gap-2 pt-4 border-t border-gray-100">
                {exp.skills.map((skill) => (
                  <span
                    class="px-3 py-1 text-xs font-medium rounded-full"
                    style={`color: ${siteConfig.accentColor}; border: 1px solid ${siteConfig.accentColor}40; background-color: ${siteConfig.accentColor}08;`}
                  >
                    {skill}
                  </span>
                ))}
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>
)}
