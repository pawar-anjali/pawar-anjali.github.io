---
import Base from "./Base.astro";
import { fmtDate, pad } from "../lib";
const { frontmatter } = Astro.props;
const { title, description, date, image, imageAlt, topic, number, readMinutes, linkedin, tags = [] } = frontmatter;
---
<Base title={`${title} | Anjali Pawar`} description={description} image={image} type="article">
  <article class="section">
    <div class="wrap">
      <div class="article">
        <a href="/blog/" style="font-size:15px;font-weight:600;color:var(--teal)">← All posts</a>
        <p class="note-meta" style="margin-top:36px">Nº {pad(number)} · {fmtDate(date)} · {topic} · {readMinutes} min read</p>
        <h1 class="serif h-lg" style="margin-bottom:40px">{title}</h1>
      </div>
      {image && (
        <figure style="max-width:880px;margin:0 auto 56px">
          <img src={image} alt={imageAlt || ""} style="width:100%;border-radius:18px;border:1px solid var(--rule)" />
          <figcaption class="figcap"><span>Fig. 01</span><span>Looks like full coverage. Actually has gaps.</span></figcaption>
        </figure>
      )}
      <div class="article">
        <div class="article-body"><slot /></div>
        {tags.length > 0 && <div class="chips" style="margin-top:36px">{tags.map((t: string) => <span class="chip">#{t}</span>)}</div>}
        <div class="card" style="margin-top:56px;display:flex;flex-wrap:wrap;gap:20px;align-items:center;justify-content:space-between">
          <div style="display:flex;gap:16px;align-items:center">
            <img src="/anjali-avatar.jpg" alt="" width="56" height="56" style="width:56px;height:56px;border-radius:50%;object-fit:cover" />
            <div><strong>Anjali Pawar</strong><br /><span class="muted" style="font-size:15px">QA Automation Lead, writing on testing and AI quality.</span></div>
          </div>
          <a href={linkedin || "https://www.linkedin.com/in/pawaranjali"} class="btn btn-dark">{linkedin ? "Discuss on LinkedIn" : "Follow on LinkedIn"}</a>
        </div>
      </div>
    </div>
  </article>
</Base>
